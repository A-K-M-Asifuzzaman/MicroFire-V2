# Optional FUTURE server-side integrations. Phase Zero reads none of these.
# Put local server configuration in apps/web/.env.local, never NEXT_PUBLIC_.
NASA_API_KEY=
NASA_ADS_TOKEN=
SEMANTIC_SCHOLAR_API_KEY=
OPENAI_API_KEY=
# Meshy credentials belong only in the owner's asset tooling, never the web app.
# No enabled-paid-generation switch exists in Phase Zero.

# Implemented M2 backend: local loopback only, disabled by default.
# Supply secrets through a private local server environment; never commit real values.
MICROFIRE_LOCAL_GAME_PREVIEW=0
MICROFIRE_PREVIEW_ORIGIN=
MICROFIRE_PREVIEW_ACCESS_TOKEN=
MICROFIRE_PREVIEW_SIGNING_KEY=
MICROFIRE_PREVIEW_REALM_ID=
MICROFIRE_PREVIEW_KEY_ID=
# Private review routes require a separate random 32-byte base64url credential in this header:
# x-microfire-review-token. Use a loopback-bound server; never put it in URLs or NEXT_PUBLIC variables.
MICROFIRE_REVIEW_ACCESS_TOKEN=
