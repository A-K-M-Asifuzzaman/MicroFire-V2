# Optional FUTURE server-side integrations. Phase Zero reads none of these.
# Put local server configuration in apps/web/.env.local, never NEXT_PUBLIC_.
NASA_API_KEY=
NASA_ADS_TOKEN=
SEMANTIC_SCHOLAR_API_KEY=
OPENAI_API_KEY=
# Meshy credentials belong only in the owner's asset tooling, never the web app.
# No enabled-paid-generation switch exists in Phase Zero.

# Implemented M2 backend: local loopback only, disabled by default.
# Supply secrets through a private local server environment; never commit real values.
MICROFIRE_LOCAL_GAME_PREVIEW=0
MICROFIRE_PREVIEW_ORIGIN=
MICROFIRE_PREVIEW_ACCESS_TOKEN=
MICROFIRE_PREVIEW_SIGNING_KEY=
MICROFIRE_PREVIEW_REALM_ID=
MICROFIRE_PREVIEW_KEY_ID=
# Unmounted campaign remediation candidates. These flags do not mount routes or constitute review approval.
MICROFIRE_LOCAL_CAMPAIGN=0
MICROFIRE_CAMPAIGN_ORIGIN=
MICROFIRE_CAMPAIGN_ACCESS_TOKEN=
MICROFIRE_CAMPAIGN_SIGNING_KEY=
MICROFIRE_CAMPAIGN_REALM_ID=
MICROFIRE_CAMPAIGN_KEY_ID=
# Public visitors never receive an operator secret. TLS PostgreSQL and exact-commit security approval are required.
MICROFIRE_PUBLIC_CAMPAIGN_ENABLED=0
MICROFIRE_PUBLIC_CAMPAIGN_REVIEWED_PROTOCOL=
MICROFIRE_PUBLIC_CAMPAIGN_ORIGIN=
MICROFIRE_PUBLIC_CAMPAIGN_REALM_ID=
MICROFIRE_PUBLIC_CAMPAIGN_RUNTIME_ID=
MICROFIRE_PUBLIC_CAMPAIGN_CSRF_KEY=
MICROFIRE_PUBLIC_CAMPAIGN_ABUSE_KEY=
MICROFIRE_PUBLIC_CAMPAIGN_DATABASE_URL=
