{
  "name": "microfire-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @microfire/web",
    "build": "npm run build --workspace @microfire/web",
    "start": "npm run start --workspace @microfire/web",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @microfire/web",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:data": "node --import tsx scripts/validate-sources.ts",
    "eval:science": "node --import tsx scripts/eval-science.ts",
    "security": "node scripts/security-check.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run validate:data && npm run eval:science && npm run security && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
