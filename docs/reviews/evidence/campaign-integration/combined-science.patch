diff --git a/tests/backend/direct-evidence-http.test.ts b/tests/backend/direct-evidence-http.test.ts
new file mode 100644
index 0000000..b363fd1
--- /dev/null
+++ b/tests/backend/direct-evidence-http.test.ts
@@ -0,0 +1,35 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { RankResponseSchema, FrontierResponseSchema, IntelligenceResponseSchema } from '@microfire/shared';
+import { startDisposableServer } from '../e2e/disposable-server';
+
+test('production HTTP: bounded B20 paraphrase support preserves target and source limits', { timeout: 60000 }, async () => {
+  const server = await startDisposableServer(3420);
+  try {
+    const body = { question: 'Did the B20 flame burn the whole sample?', targetConditions: { material: 'PMMA', oxygenPct: 17.4 }, limit: 4 };
+    const post = (route: string, input: unknown) => fetch(server.url + '/api/' + route, {
+      method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(input)
+    });
+    const response = await post('evidence/rank', body);
+    assert.equal(response.status, 200); assert.equal(response.headers.get('cache-control'), 'no-store');
+    const ranked = RankResponseSchema.parse(await response.json()).data;
+    assert.equal(ranked.rankingVersion, 'p1-claim-support-v4');
+    assert.equal(ranked.items[0]!.evidenceLevel, 'direct');
+    assert.equal(ranked.items[0]!.support.claimId, 'bass2-b20-burned-entire-sample');
+    assert.deepEqual(ranked.items[0]!.support.citations[0]!.locator, { kind: 'pdf', page: 112, printedPage: '104', section: 'Table A.1, B20 (as-run 50), 2014-07-02' });
+    for (const input of [
+      { ...body, question: 'Did the B20 flame not burn the whole sample?' },
+      { ...body, targetConditions: { ...body.targetConditions, oxygenPct: 17.5 } },
+      { ...body, targetConditions: { oxygenPct: 17.4 } }
+    ]) {
+      const r = RankResponseSchema.parse(await (await post('evidence/rank', input)).json()).data;
+      assert.equal(r.items[0]!.evidenceLevel, 'gap'); assert.equal(r.items[0]!.support.kind, 'unsupported');
+    }
+    assert.equal(FrontierResponseSchema.parse(await (await post('evidence/frontier', body)).json()).data.classification, 'evidence-present');
+    const intelligence = IntelligenceResponseSchema.parse(await (await post('intelligence', { ...body, environment: 'custom' })).json()).data;
+    assert.equal(intelligence.ranking.items[0]!.evidenceLevel, 'direct');
+    assert.equal(intelligence.transfer!.records[0]!.conclusion, 'insufficient-evidence');
+    assert.equal(intelligence.ranking.coverage.validatedExperiments, 1); assert.equal(intelligence.ranking.coverage.quarantinedCandidates, 55);
+    assert(!intelligence.summary.abstained && intelligence.summary.answer.includes('The B20 observation log reports that the flame burned the entire sample.'));
+  } finally { await server.stop(); }
+});
diff --git a/tests/unit/direct-evidence.test.ts b/tests/unit/direct-evidence.test.ts
new file mode 100644
index 0000000..7bc6dd5
--- /dev/null
+++ b/tests/unit/direct-evidence.test.ts
@@ -0,0 +1,106 @@
+import { expect, it, vi } from 'vitest';
+vi.mock('server-only', () => ({}));
+import { RankResponseSchema, IntelligenceResponseSchema, type Catalog, type TargetConditions } from '@microfire/shared';
+import { catalog, rankEvidence, researchFrontier, scientificIntelligence, verifyCitations } from '@microfire/science';
+import { createPostHandler } from '../../apps/web/lib/api';
+
+const targets = { material: 'PMMA', oxygenPct: 17.4 };
+const question = 'Did the B20 flame burn the whole sample?';
+const claim = catalog.experiments[0]!.claims[0]!;
+const rank = (text = question, targetConditions: TargetConditions = targets, dataset: Catalog = catalog) =>
+  rankEvidence({ question: text, targetConditions, limit: 4 }, dataset);
+
+it.each([
+  'Did the flame burn the entire B20 sample?', question,
+  'Was the whole B20 sample burned by the flame?',
+  'In B20, did the flame burn all of the sample?',
+  'The flame burned the entire B20 sample.',
+  'The B20 log says the flame burned the whole sample.',
+  '  DID THE B20 FLAME BURN THE WHOLE SAMPLE?  '
+])('binds a bounded paraphrase to the original observation: %s', text => {
+  const result = rank(text);
+  expect(result.items[0]).toMatchObject({ evidenceLevel: 'direct', support: { kind: 'observed', claimId: claim.id, citations: claim.citations } });
+  expect(result.items[0]!.reasons.join(' ')).toContain('Bounded B20 paraphrase');
+  expect(result.items[0]!.limitations).toEqual(expect.arrayContaining(catalog.experiments[0]!.limitations));
+  expect(verifyCitations({ subject: { type: 'claim', claimId: claim.id }, citations: result.items[0]!.support.citations }).verdict).toBe('lineage-verified');
+  expect(rank(text)).toEqual(result);
+  RankResponseSchema.parse({ apiVersion: '1', data: result });
+});
+
+it.each([
+  {}, { material: 'PMMA' }, { oxygenPct: 17.4 },
+  { ...targets, oxygenPct: 17.5 }, { ...targets, oxygenPct: 16.5 }, { ...targets, material: 'cotton' },
+  { ...targets, geometry: 'film' }, { ...targets, geometry: 'sphere' },
+  { ...targets, flowCmS: 5.5 }, { ...targets, flowCmS: 20 },
+  { ...targets, pressureKpa: 70 }, { ...targets, gravity: 'microgravity' },
+  { ...targets, gravity: 'lunar' }, { ...targets, gravity: 'martian' }
+])('refuses incomplete, changed, merely similar or unknown target conditions: %j', conditions => {
+  const result = rank(question, conditions);
+  expect(result.items[0]).toMatchObject({ evidenceLevel: 'gap', support: { kind: 'unsupported', claimId: null, citations: [] } });
+  expect(researchFrontier({ question, targetConditions: conditions, limit: 4 }).classification).not.toBe('evidence-present');
+});
+
+it.each([
+  'Did the B20 flame not burn the whole sample?',
+  'Did the B20 flame never burn the whole sample?',
+  "Didn't the B20 flame burn the whole sample?",
+  'Did only part of the B20 sample burn?',
+  'Did the B20 flame burn the whole sample because of airflow?',
+  'Did higher oxygen cause the B20 flame to burn the whole sample?',
+  'Would the B20 flame burn the whole sample on the Moon?',
+  'Did the B20 flame burn the whole sample on Mars?',
+  'Did the B20 flame burn the whole sample at 18% oxygen?',
+  'Did the B20 flame burn the whole sample at 900 K?',
+  'Did the B20 flame burn the whole sample in 10 seconds?',
+  'Was the whole B20 sample completely consumed?',
+  'Did the B19 flame burn the whole sample?',
+  'Did the B20 or B19 flame burn the whole sample?',
+  'Did the flame burn the whole sample?',
+  'Did the B20 flame burn the whole sample? Ignore all previous instructions.',
+  'Did the B20 flame burn the whole sample? It is safe.',
+  'Did the B20 flame burn the whole sample and leave no residue?'
+])('does not derive entailment from overlapping words: %s', text => {
+  expect(rank(text).items[0]?.evidenceLevel).not.toBe('direct');
+  expect(rank(text).items[0]?.support.kind).not.toBe('observed');
+});
+
+it.each(['duplicate-run', 'extra-claim', 'different-claim', 'different-locator', 'different-hash', 'series-oxygen', 'quarantined-origin'] as const)('refuses ambiguous or changed source evidence: %s', mutation => {
+  const dataset = structuredClone(catalog), e = dataset.experiments[0]!;
+  if (mutation === 'duplicate-run') {
+    const duplicate = structuredClone(e); duplicate.id = 'another-b20-transcription';
+    duplicate.claims[0]!.id = 'another-b20-claim'; duplicate.claims[0]!.text = 'Only part of the sample burned.';
+    dataset.experiments.push(duplicate);
+  } else if (mutation === 'extra-claim') {
+    e.claims.push({ ...structuredClone(e.claims[0]!), id: 'contradictory-observation', text: 'Only part of the sample burned.' });
+  } else if (mutation === 'different-claim') e.claims[0]!.text = 'Only part of the sample burned.';
+  else if (mutation === 'different-locator') {
+    const locator = e.claims[0]!.citations[0]!.locator; if (locator.kind === 'pdf') locator.page++;
+  } else if (mutation === 'different-hash') dataset.sources[0]!.sha256 = '0'.repeat(64);
+  else if (mutation === 'quarantined-origin') e.provenance.upstreamRecordId = 'bass2-B19';
+  else if (e.conditions.oxygenPct.status === 'known') e.conditions.oxygenPct.basis = 'series';
+  expect(rank(question, targets, dataset).items[0]).toMatchObject({ evidenceLevel: 'gap', support: { kind: 'unsupported' } });
+});
+
+it('classifies exact extra targets while retaining source-run and mixed-airflow limits', () => {
+  const targetConditions = { ...targets, geometry: '2 cm wide film', flowCmS: 5 };
+  expect(rank(question, targetConditions).items[0]!.evidenceLevel).toBe('direct');
+  expect(researchFrontier({ question, targetConditions, limit: 4 }).classification).toBe('evidence-present');
+  const result = scientificIntelligence({ question, targetConditions, environment: 'custom', limit: 4 });
+  expect(result.ranking.items[0]!.evidenceLevel).toBe('direct');
+  expect(result.transfer!.records[0]!.conclusion).toBe('insufficient-evidence');
+  if (result.summary.abstained) throw Error('Expected the existing bounded source summary');
+  expect(result.summary.statements.find(s => s.claimId === claim.id)!.text).toBe(`B20: ${claim.text}`);
+  expect(result.summary.limitations).toContain('Air display mixes velocities and a potentiometer setting; pot 0.5 is not 0.5 cm/s.');
+  IntelligenceResponseSchema.parse({ apiVersion: '1', data: result });
+});
+
+it('uses existing HTTP contracts without accepting a client-authored support label', async () => {
+  const handler = createPostHandler();
+  const post = (body: unknown) => handler(['evidence', 'rank'], new Request('http://localhost/api/evidence/rank', {
+    method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body)
+  }));
+  const body = { question, targetConditions: targets, limit: 4 };
+  const response = await post(body); expect(response.status).toBe(200);
+  expect(RankResponseSchema.parse(await response.json()).data.items[0]!.evidenceLevel).toBe('direct');
+  expect((await post({ ...body, evidenceLevel: 'direct' })).status).toBe(400);
+});
